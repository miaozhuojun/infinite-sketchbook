 },

 "narrative": {
  "episode": { "hookWithin": 3.0, "maxAhaGap": 30, "requireRoles": ["hook", "aha", "recap", "next"], "minQuiz": 2 },
  "segment": { "requireRoles": [], "minQuiz": 0 }
 }
